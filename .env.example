PORT=3000
NODE_ENV=production

# Neon Console > Connect > Connection pooling OFF 상태의 Direct connection string 권장
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

CORS_ORIGIN=https://hlbbusisup-creator.github.io
ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_VALUE
# 삭제코드는 서버 고정값으로 통합되어 환경변수를 사용하지 않습니다.
# 공통 삭제코드: DpdlclDpfql
PG_POOL_MAX=3

# 기존 SQLite 이관 시에만 사용
SQLITE_PATH=./data/project_zero_history.sqlite
